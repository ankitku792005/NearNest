<% layout("/layout/boilerplate") %>

<script>
  const mapToken = "<%= process.env.Map_Token %>";
  const coordinates = <%- JSON.stringify((listing.geometry && listing.geometry.coordinates) || [88.3, 22.6]) %>;
</script>

<div class="row mt-4">
  <div class="col-8 offset-2">

    <h3 class="mb-4"> <%= listing.title %></h3>

    <div class="card shadow-sm listing-card">

      <% if (listing.image && listing.image.url) { %>
        <img
          src="<%= listing.image.url %>"
          class="card-img-top"
          alt="<%= listing.title %>"
          style="height: 350px; object-fit: cover;"
        />
      <% } %>

      <div class="card-body">

        <!-- <h4 class="card-title mb-3">
          <%= listing.title %>
        </h4> -->
 <p class="card-text"> owned by
          <%= listing.owner.username %> </p>
      <p class="card-text">
          <%= listing.description %>
        </p>

        <hr>

        <p class="mb-2">
          <strong>Price:</strong>
          <%= listing.price ? "₹" + listing.price.toLocaleString("en-IN") + " onwards" : "Contact for price" %>
        </p>

        <p class="mb-2">
          <strong>Location:</strong>
          <%= listing.location %>
        </p>

        <p class="mb-3">
          <strong>Country:</strong>
          <%= listing.country %>
        </p>
<%
  const rc = listing.reviews.length;
  const avg = rc ? listing.reviews.reduce((a, r) => a + r.rating, 0) / rc : 0;
%>
<div class="jd-meta mb-3">
  <% if (rc) { %><span class="jd-rate"><%= avg.toFixed(1) %> <i class="bi bi-star-fill"></i></span><span class="small text-secondary"><%= rc %> Ratings</span><% } else { %><span class="jd-rate new">New</span><% } %>
  <span class="small text-secondary">· <%= listing.category %></span>
</div>
<div class="jd-actions mb-3">
  <% if (listing.phone) { %><a class="btn-call" href="tel:<%= listing.phone %>"><i class="bi bi-telephone-fill"></i> Call <%= listing.phone %></a><% } %>
  <% if (waLink(listing.whatsapp || listing.phone)) { %><a class="btn-wa" target="_blank" rel="noopener" href="<%= waLink(listing.whatsapp || listing.phone) %>"><i class="bi bi-whatsapp"></i> WhatsApp</a><% } %>
  <% if (listing.website) { %><a class="btn-ghost" target="_blank" rel="noopener" href="<%= listing.website %>"><i class="bi bi-globe"></i> Website</a><% } %>
  <a class="btn-ghost" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(listing.title + ' ' + listing.location) %>"><i class="bi bi-sign-turn-right"></i> Directions</a>
</div>
<% if (listing.hours) { %><p class="mb-2"><i class="bi bi-clock"></i> <strong>Hours:</strong> <%= listing.hours %></p><% } %>
<!-- Business Contact Information -->
<div class="mt-4">
    <h4>Contact Information</h4>

    <% if (listing.phone) { %>
        <p>
            <i class="bi bi-telephone"></i>
            <strong>Phone:</strong>
            <a href="tel:<%= listing.phone %>">
                <%= listing.phone %>
            </a>
        </p>
    <% } %>

    <% if (listing.email) { %>
        <p>
            <i class="bi bi-envelope"></i>
            <strong>Email:</strong>
            <a href="mailto:<%= listing.email %>">
                <%= listing.email %>
            </a>
        </p>
    <% } %>

   

 <% if(currentUser && currentUser._id.equals(listing.owner._id)) { %>
        <div class="d-flex gap-2">

          <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark"
          >
            Edit Listing
          </a>

          <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
          >
            <button class="btn btn-danger" type="submit">
              Delete Listing
            </button>
          </form>

        </div>
         <% }  %>

      </div>
    </div>
<!-- review -->
 <% if(currentUser){%>
<h4>Leave a Review</h4>

<form action="/listings/<%= listing._id %>/reviews" method="POST">

    <!-- Rating -->
    <!-- <div class="mb-3">
        <label for="rating" class="form-label">
            Rating
        </label>

        <input
            type="range"
            min="1"
            max="5"
            id="rating"
            name="review[rating]"
            class="form-range"
        >
          </div> -->
           <div class="mb-3">
        <label for="rating" class="form-label">
            Rating
        </label>
        <fieldset class="starability-slot">
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
   </div>

    <!-- Comment -->
    <div class="mb-3">
        <label for="comment" class="form-label">
            Comment
        </label>

        <textarea
            id="comment"
            name="review[comment]"
            rows="4"
            class="form-control"
            placeholder="Write your review..."
            required
        ></textarea>
    </div>

    <!-- Submit -->
    <button class="mb-3 btn btn-dark">
        Submit Review
    </button>
</form>
<%}%>
<p><b>Reviews</b></p>

<% if (listing.reviews.length === 0) { %>

  <p>No reviews yet.</p>

<% } else { %>
<div class="row">
  <% listing.reviews.forEach(review => { %>

    <div class="card col-5 ms-3 mb-3">
      <div class="card-body">
        <% if (review.author) { %>
    <p>By: <%= review.author.username %></p>
<% } else { %>
    <p>Author unavailable</p>
<% } %>
        <!-- <h5>Rating: <%= review.rating %>/5</h5> -->
 <p class="starability-result card-text" data-rating="<%= review.rating %>">
  </p>
        <p>
          <%= review.comment %>
        </p>

      </div>
      <form class="mb-3" method="post" action="/listings/<%=listing._id %>/reviews/<%=review._id %>?_method=DELETE">
        <button class="btn btn-dark">delete</button>
      </form>
    </div>

  <% }) %>
 </div>
<% } %>
</div>
 <div class="col-8 offset-2 mb-3">
  <h3>Find us on the map</h3>
<div id="map"></div>
</div>
  </div>
 <script src="/js/map.js"></script>