<% layout("/layout/boilerplate") %>

<div class="container">
  <div class="jd-error">

    <div class="jd-error-code"><%= statusCode || 500 %></div>

    <h2 class="jd-error-title">
      <%= statusCode === 404 ? "Page not found" : "Something went wrong" %>
    </h2>

    <p class="jd-error-msg"><%= message || "An unexpected error occurred." %></p>

    <p class="jd-error-help">
      The page you are looking for may have been moved or deleted.
      Try searching for what you need instead.
    </p>

